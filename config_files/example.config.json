{
	"client": {
		"name": "ESP32_S3 Testbench",
		"type": "esp32",
		"device_id": "bedroom"
	},
	"capabilities": [
		"nfc_reader",
		"display",
		"buttons",
		"minimal_messaging"
	],
	"backend": {
		"ip": "<backend-host>",
		"port": 8010
	},
	"wifi": {
		"ssid": "<wifi-ssid>",
		"password": "<wifi-password>"
	},
	"server": {
		"timeout_ms": 5000
	},
	"logging": {
		"level": "DEBUG",
		"console": {
			"enabled": false
		},
		"syslog": {
			"enabled": true,
			"host": "<syslog-host>",
			"port": 514,
			"facility": "local0",
			"hostname": "jukeplayer",
			"tag": "jukeplayer",
			"boot_buffer_lines": 50
		}
	},
	"mqtt": {
		"enabled": false,
		"start_delay_s": 5,
		"broker": "<mqtt-broker-host>",
		"port": 1883,
		"user": "<mqtt-user>",
		"password": "<mqtt-password>",
		"discovery_prefix": "homeassistant"
	},
	"webrepl": {
		"enabled": true,
		"password": "<webrepl-password>"
	},
	"hardware": {
		"spi": {
			"spi_unit": 1,
			"display_baudrate": 24000000,
			"nfc_baudrate": 4000000,
			"baudrate": 4000000,
			"polarity": 0,
			"phase": 0,
			"sck": 13,
			"mosi": 11,
			"miso": 12
		},
		"oled": {
			"enabled": false,
			"interface": "spi",
			"mosi": 1,
			"miso": 2,
			"cs": 8,
			"dc": 3,
			"reset": 46,
			"led_backlight": 21,
			"width": 128,
			"height": 64
		},
		"tft": {
			"enabled": true,
			"driver": "ili9488",
			"cs": 5,
			"a0": 7,
			"reset": 4,
			"led": 15,
			"backlight_active_low": true,
			"width": 480,
			"height": 320,
			"rotate_180": true,
			"mirror": false,
			"color_invert": false
		},
		"nfc_reader": {
			"enabled": true,
			"cs": 10,
			"irq": 14,
			"reset": 9
		},
		"encoder": {
			"enabled": true,
			"clk": 1,
			"dt": 2,
			"sw": 6
		},
		"buttons": {
			"enabled": true,
			"debounce_ms": 100,
			"pins": {
				"play_pause": {
					"pin": 17,
					"action_name": "play_pause",
					"active_low": true,
					"label": "Play / Pause"
				},
				"next_track": {
					"pin": 3,
					"action_name": "next_track",
					"active_low": true,
					"label": "Next"
				},
				"previous_track": {
					"pin": 18,
					"action_name": "previous_track",
					"active_low": true,
					"label": "Previous"
				},
				"stop": {
					"pin": 8,
					"action_name": "stop",
					"active_low": true,
					"label": "Stop"
				},
				"nfc_card": {
					"pin": 16,
					"action_name": "nfc_card",
					"active_low": false,
					"label": "NFC"
				},
				"encoder_sw": {
					"pin": 6,
					"action_name": "encoder_sw",
					"active_low": true,
					"label": "Encoder"
				},
				"utility_button": {
					"pin": 48,
					"action_name": "utility_button",
					"active_low": true,
					"label": "Utility"
				}
			}
		},
		"leds": {
			"enabled": true,
			"pins": {
				"red": 39,
				"green": 40,
				"blue": 41
			}
		}
	}
}