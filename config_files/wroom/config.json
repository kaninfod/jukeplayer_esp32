{
  "client": {
    "name": "ESP32 Testrig",
    "type": "esp32",
    "device_id": "bedroom"
  },
  "capabilities": [
    "nfc_reader",
    "display",
    "buttons",
    "minimal_messaging"
  ],
  "backend": {
    "ip": "192.168.68.102",
    "port": 8001
  },
  "wifi": {
    "ssid": "neptunium",
    "password": "neppetun#1733"
  },
  "mqtt": {
    "enabled": true,
    "broker": "192.168.68.100",
    "port": 1883,
    "user": "mqtt-user",
    "password": "mqtt#sec#2472",
    "discovery_prefix": "homeassistant"
  },
  "server": {
    "timeout_ms": 5000
  },
  "logging": {
    "level": "INFO",
    "console": {
      "enabled": true
    },
    "syslog": {
      "enabled": true,
      "host": "192.168.68.102",
      "port": 514,
      "facility": "local0",
      "hostname": "jukeplayer",
      "tag": "jukeplayer",
      "boot_buffer_lines": 50
    }
  },
  "webrepl": {
    "enabled": true,
    "password": "jukeplay"
  },
  "dummy_mode": false,
  "hardware": {
    "spi": {
      "spi_unit": 1,
      "baudrate": 4000000,
      "polarity": 0,
      "phase": 0,
      "sck": 18,
      "mosi": 23,
      "miso": 19
    },
    "oled": {
      "enabled": true,
      "sda": 13,
      "scl": 14,
      "width": 128,
      "height": 64
    },
    "nfc_reader": {
      "enabled": true,
      "reset": 4,
      "cs": 5
    },
    "encoder": {
      "enabled": true,
      "clk": 25,
      "dt": 27,
      "sw": 16
    },
    "buttons": {
      "enabled": true,
      "debounce_ms": 100,
      "pins": {
          "play_pause": {
                "pin": 33,
                "action_name": "play_pause",
                "active_low": true
              },
        "next_track": {
                "pin": 35,
                "action_name": "next_track",
                "active_low": true,
                "label": "Next"
              },
        "previous_track": {
                "pin": 32,
                "action_name": "previous_track",
                "active_low": true,
                "label": "Previous"
              },
        "stop": {
                "pin": 34,
                "action_name": "stop",
                "active_low": true,
                "label": "Stop"
              },
        "nfc_card": {
                "pin": 26,
                "action_name": "nfc_card",
                "active_low": false,
                "label": "NFC"
              },
        "encoder_sw": {
                "pin": 16,
                "action_name": "encoder_sw",
                "active_low": true,
                "label": "Encoder"
              }
      }
    }
  }
}